// SPDX-License-Identifier: MIT OR Apache-2.0
// logf polynomial coefficient generation for PureLibm
//
// Usage:  sollya logf.sollya
//
// NOTE: The coefficients printed by this script are close to but not
// bit-identical to the hardcoded values in src/math/binary32/logf.c.
// CORE-MATH's coefficients use additional hand-tuning beyond what
// generic fpminimax produces.  The hardcoded values are the ground
// truth — they have been verified by exhaustive f32 MPFR comparison.
// This script documents the approximation strategy and provides
// a reproducible starting point.

prec = 200;
display = hexadecimal;

// --- Range-reduction structure ---
//
// x = 2^e * m,  m in [1, 2)
// log(x) = e*ln(2) + log(m)
//
// 64-entry LUT: tr[j] ≈ 1/m for m in interval j, tl[j] = log(1/tr[j])
// z = m*tr[j] - 1,  z in [-1/128, 1/128]
// log(m) = log(1+z) + tl[j]

A = 1.0/128.0;
I = [-A, A];

// --- b[]: degree-3 minimax of log(1+z) (fast path) ---
// The fast path evaluates: (e*ln2 + tl[j]) + z*b[0] + z^2*(b[1] + z*b[2])
// which is: (e*ln2 + tl[j]) + b[0]*z + b[1]*z^2 + b[2]*z^3
print("// b[] — fpminimax(log(1+x), deg 3) on [-1/128, 1/128] (fast path):");
pb = fpminimax(log(1+x), 3, [|53,53,53,53|], I, absolute, floating, 0);
for i from 0 to 3 do {
    print("  ", coeff(pb, i), ",");
};
print("");

// --- c[]: degree-6 approximation of (log(1+z)-z)/z^2 (slow path) ---
// f = z^2 * (c[0] + z*c[1] + z^2*(c[2] + z*c[3] + z^2*(c[4] + z*c[5] + z^2*c[6])))
print("// c[] — fpminimax((log(1+x)-x)/x^2, deg 6) on [-1/128, 1/128] (slow path):");
pc = fpminimax((log(1+x)-x)/(x*x), 6, [|53,53,53,53,53,53,53|], I, absolute, floating, 0);
for i from 0 to 6 do {
    print("  ", coeff(pc, i), ",");
};
print("");

// --- Error bounds ---
print("// Infinity-norm error for fpminimax polynomials:");
print("//   b:  ", dirtyinfnorm(pb - log(1+x), I));
print("//   c:  ", dirtyinfnorm(pc - (log(1+x)-x)/(x*x), I));
