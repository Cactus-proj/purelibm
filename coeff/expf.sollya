// SPDX-License-Identifier: MIT OR Apache-2.0
// expf polynomial coefficient generation for PureLibm
//
// Usage:  sollya expf.sollya
//
// NOTE: The coefficients printed by this script are close to but not
// bit-identical to the hardcoded values in src/math/binary32/expf.c.
// CORE-MATH's coefficients use additional hand-tuning beyond what
// generic fpminimax produces.  The hardcoded values are the ground
// truth — they have been verified by exhaustive f32 MPFR comparison.
// This script documents the approximation strategy and provides
// a reproducible starting point.

prec = 200;
display = hexadecimal;

// --- Range-reduction structure ---
//
// x = k*ln(2) + j*ln(2)/64 + h*ln(2)  where h in [-0.5, 0.5]
// exp(x) = 2^k * exp(j*ln(2)/64) * exp(h*ln2)
//        = 2^k * tb[j] * exp(h*ln2)
//
// b[] (fast path): approximates exp(ln(2)*h) on [-0.5, 0.5]
// c[] (slow path): approximates (exp(ln(2)*h)-1)/h on [-0.5, 0.5]
//
// The LUT tb[] = exp(j*ln(2)/64) for j=0..63 is derived analytically
// from the mathematical constant e and is NOT generated by this script.

A = 0.5;
I = [-A, A];

// --- b[]: degree-3 approximation of exp(ln(2)*h) ---
print("// b[] — fpminimax(exp(ln2*x), deg 3) on [-0.5, 0.5]:");
pb = fpminimax(exp(log(2)*x), 3, [|53,53,53,53|], I, absolute, floating, 0);
for i from 0 to 3 do {
    print("  ", coeff(pb, i), ",");
};
print("");

// --- c[]: degree-5 approximation of (exp(ln(2)*h)-1)/h ---
print("// c[] — fpminimax((exp(ln2*x)-1)/x, deg 5) on [-0.5, 0.5]:");
pc = fpminimax((exp(log(2)*x)-1)/x, 5, [|53,53,53,53,53,53|], I, absolute, floating, 0);
for i from 0 to 5 do {
    print("  ", coeff(pc, i), ",");
};
print("");

// --- Error bounds ---
print("// Infinity-norm error for fpminimax polynomials:");
print("//   b:  ", dirtyinfnorm(pb - exp(log(2)*x), I));
print("//   c:  ", dirtyinfnorm(pc - (exp(log(2)*x)-1)/x, I));
